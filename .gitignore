# Secrets and local environment
.env
.env.*
!.env.example
!infra/deployment/.env.staging.example
*.pem
*.key
firebase-service-account*.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/

# Node / React Native / Expo
node_modules/
.expo/

# Expo prebuild output. app.json is the source of truth for the native
# configuration, so these directories are regenerated by
# `npx expo prebuild` and must never be hand-edited or committed.
android/
ios/

dist/
build/
coverage/
*.jks
*.keystore
*.mobileprovision

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
outputs/
*.tmp

# Locally collected external-data snapshots
# Source descriptors and pipeline code remain tracked; fetched payloads are
# reviewed before any explicit decision to redistribute or commit them.
data/raw/*/snapshots/

# 문서 렌더링 작업 디렉터리.
# 제출 산출물·생성 스크립트·양식 원본만 추적하고, LibreOffice 프로파일과
# 중간 렌더 결과(page PNG, probe, tmp)는 재유입되지 않도록 제외한다.
.docx_work/*
!.docx_work/build_database_report.py
!.docx_work/render_docx_windows.py
!.docx_work/template.docx
!.docx_work/decision_erd.png
!.docx_work/final_render/
.docx_work/final_render/*
!.docx_work/final_render/*.pdf

# ML 중간 산출물
ml/data/interim/
ml/data/processed/
# 루트의 일반 `outputs/` 규칙이 ml/outputs/까지 삼키므로 되살린 뒤
# 예측 파일만 다시 제외한다. 선정·평가 증거는 추적 대상이다.
!ml/outputs/
ml/outputs/predictions/
*.joblib.tmp

# gymvisual 미디어 파일
data/media/