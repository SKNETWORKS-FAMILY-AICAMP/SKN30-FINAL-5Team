# Local Docker orchestration only. Every value below is a placeholder or
# local-only default. Never reuse these credentials outside local development.
COMPOSE_PROJECT_NAME=exercise_wellness

# PostgreSQL
POSTGRES_DB=exercise_app_demo
POSTGRES_TEST_DB=exercise_app_test
POSTGRES_USER=exercise_app
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=55432

# API
API_PORT=8000
LOG_LEVEL=INFO

# Qdrant host ports. The API remains QDRANT_ENABLED=false in the base Compose
# configuration; running the server does not opt the decision path into Vector retrieval.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
