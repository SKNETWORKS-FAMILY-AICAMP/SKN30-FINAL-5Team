# This file documents names only. Never commit infra/deployment/.env.staging.
DATABASE_URL=<aws-secrets-manager-injected-postgresql-url>
LOG_LEVEL=INFO

# Firebase Admin verification. The project ID is read from Secrets Manager at
# deployment time. When `/helkki/staging/firebase_id` is JSON, extract its
# `FIREBASE_PROJECT_ID` scalar field; never inject the complete JSON document
# as this environment value. The service-account JSON stays in a mode-0600 host
# file and is mounted read-only into the API container.
FIREBASE_PROJECT_ID=<aws-secrets-manager-injected-firebase-project-id>
FIREBASE_ADMIN_CREDENTIALS_HOST_PATH=<absolute-host-path-to-firebase-admin-service-account-json>
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin-service-account.json

# Birthdate encryption uses the EC2 instance role, not static AWS access keys.
# The alias must point to a symmetric customer-managed KMS key in this region.
AWS_REGION=ap-northeast-2
BIRTHDATE_KMS_KEY_ID=alias/helkki-staging-birthdate

# Reuses the existing exercise-media bucket and separate IAM prefix policy.
EXERCISE_MEDIA_S3_BUCKET=exercise-app-media-343953861875-ap-northeast-2-an
EXERCISE_MEDIA_S3_REGION=ap-northeast-2
PROFILE_IMAGE_S3_PREFIX=profile-images/
PROFILE_IMAGE_URL_EXPIRY_SECONDS=300

# TLS. The domain must already resolve to this host before the stack starts:
# Caddy requests the certificate on boot and the ACME HTTP-01 challenge fails
# if the A record is missing or still pointing elsewhere.
API_DOMAIN=<api.example.com>
ACME_EMAIL=<ops-contact@example.com>

# Optional web overlay (compose.staging.web.yaml). WEB_DOMAIN serves the
# landing site and keeps /api/* backward-compatible for the deployed app.
WEB_DOMAIN=<www.example.com>
APP_DOMAIN=<app.example.com>
APEX_DOMAIN=<example.com>
LANDING_SITE_ROOT=<absolute-host-path-to-landing-site>
WEB_APP_ROOT=<absolute-host-path-to-expo-web-export>

# Exact browser origins allowed to call the API, comma-separated. Native builds
# send no Origin header and need nothing here; this is only for the Expo web
# demo. A wildcard is rejected at startup.
CORS_ALLOWED_ORIGINS=<https://app.example.com>

# Required for the public V3 routine-creation path. Values are injected from
# AWS Secrets Manager; placeholders here are names, never credentials.
QDRANT_URL=<https://approved-qdrant-endpoint>
QDRANT_API_KEY=<aws-secrets-manager-injected-qdrant-api-key>
OPENAI_API_KEY=<aws-secrets-manager-injected-openai-api-key>

# Social login. Secrets come from /helkki/staging/kakao-oauth,
# /helkki/staging/google-oauth and /helkki/staging/social-oauth-hmac-key; the
# EC2 role reads them through infra/aws/ec2-staging-secrets-policy.json. The
# HMAC key is ours, not a provider value: it digests the client IP and redirect
# so the rate-limit table never stores either in the clear. Generate it once
# with `openssl rand -base64 32` and rotate it like any other credential.
# Leaving it unset closes every social route with PROVIDER_UNAVAILABLE.
KAKAO_REST_API_KEY=<aws-secrets-manager-injected-kakao-rest-api-key>
KAKAO_CLIENT_SECRET=<aws-secrets-manager-injected-kakao-client-secret-or-empty>
GOOGLE_OAUTH_CLIENT_ID=<aws-secrets-manager-injected-google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<aws-secrets-manager-injected-google-oauth-client-secret>
SOCIAL_OAUTH_RATE_LIMIT_HMAC_KEY=<aws-secrets-manager-injected-social-oauth-hmac-key>

# Redirect callbacks are public configuration, not secrets, and must match the
# values registered in the Kakao and Google consoles exactly. Settings accepts
# only absolute http(s) callbacks, so a custom app scheme is rejected at
# startup; the mobile flow needs an https callback it can hand back to the app.
KAKAO_REDIRECT_URIS=<https://app.example.com/auth/kakao/callback>
GOOGLE_OAUTH_REDIRECT_URIS=<https://app.example.com/auth/google/callback>

# The terms revision users are asked to accept. Onboarding rejects a request that
# submits a different one, so this is the single place the answer lives; before
# it existed the mobile build held the string in a constant and told the server
# which revision the user had agreed to. Leaving it unset keeps that older
# behaviour, so the setting can be introduced without a coordinated release.
TERMS_VERSION=<approved-terms-revision>
