{
  "commands": [
    "set -euo pipefail",
    "version=v2.40.3",
    "asset=docker-compose-linux-x86_64",
    "base=https://github.com/docker/compose/releases/download/${version}",
    "install -d -m 0755 /usr/local/lib/docker/cli-plugins",
    "curl --fail --location --silent --show-error ${base}/${asset} --output /tmp/${asset}",
    "curl --fail --location --silent --show-error ${base}/${asset}.sha256 --output /tmp/${asset}.sha256",
    "cd /tmp && sha256sum --check ${asset}.sha256",
    "install -m 0755 /tmp/${asset} /usr/local/lib/docker/cli-plugins/docker-compose",
    "rm -f /tmp/${asset} /tmp/${asset}.sha256",
    "docker compose version"
  ]
}
