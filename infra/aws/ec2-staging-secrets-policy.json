{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStagingDeploymentSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:343953861875:secret:/helkki/staging/database-url-47uNZ7",
        "arn:aws:secretsmanager:ap-northeast-2:343953861875:secret:/helkki/staging/qdrant-url_key-3K39vG",
        "arn:aws:secretsmanager:ap-northeast-2:343953861875:secret:/helkki/staging/openai-api-key-eRIZ6F"
      ]
    },
    {
      "Sid": "UseStagingBirthdateEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:ap-northeast-2:343953861875:key/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/helkki-staging-birthdate"
        }
      }
    }
  ]
}
