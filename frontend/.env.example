# All EXPO_PUBLIC_* values are embedded in the client application.
# Never place client secrets, private keys, or service-account credentials here.
#
# Copy to .env.local and fill in values from your own Firebase test project.
# .env.* is gitignored except this example. Restart the Expo dev server after
# changing any value: EXPO_PUBLIC_* is inlined at bundle time.

# Application
EXPO_PUBLIC_APP_ENV=local

# API origin only, WITHOUT the /api/v1 suffix; the client appends it.
# Use the address reachable FROM THE DEVICE running the app:
#   Web (npm run web)      http://127.0.0.1:8000
#   Android emulator       http://10.0.2.2:8000
#   iOS simulator          http://127.0.0.1:8000
#   Physical device        http://<your-dev-machine-LAN-IP>:8000
# Start uvicorn with --host 0.0.0.0 for the emulator and device cases.
#
# Use 127.0.0.1 rather than localhost in browsers. uvicorn --host 0.0.0.0 binds
# IPv4 only, while browsers resolve localhost to ::1 (IPv6) first and get a
# refused connection, which surfaces as a generic network error.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Firebase public client configuration.
# Firebase console > Project settings > Your apps > Web app > SDK setup.
# Enable Authentication > Sign-in method > Email/Password for the demo flow.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Social provider public identifiers.
# Reserved for the KAKAO/NAVER contracts; unused until ADR-0009 is accepted and
# the backend exchange endpoints exist. The demo app does not read these.
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_REDIRECT_URI=
