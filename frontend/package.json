{
  "name": "helkki-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.13 <27",
    "npm": ">=10 <12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "scene-editor": "expo start --web --port 8082",
    "format": "prettier --write App.tsx index.ts src tests app.json eas.json package.json tsconfig.json eslint.config.js jest.config.js .prettierrc.json TECHNICAL_DECISIONS.md README.md",
    "format:check": "prettier --check App.tsx index.ts src tests app.json eas.json package.json tsconfig.json eslint.config.js jest.config.js .prettierrc.json TECHNICAL_DECISIONS.md README.md",
    "lint": "eslint App.tsx index.ts src tests",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build:production": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "expo": "~57.0.12",
    "expo-asset": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "57.0.4",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
