* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Hash-sealed data artifacts. manifest.json이 파일 바이트의 SHA-256을 보존하므로
# Git이 줄바꿈을 정규화하면 재검증이 실패한다. 바이트를 그대로 저장한다.
data/validation/profiles/**/*.csv        -text
data/validation/profiles/**/*.json       -text
data/validation/profiles/**/*.jsonl      -text
data/validation/review_batches/**/*.csv  -text
data/validation/review_batches/**/*.json -text
data/validation/review_batches/**/*.jsonl -text
data/normalized/**/*.json            -text
data/normalized/**/*.jsonl           -text
data/generated/**/*.json                 -text
data/generated/**/*.jsonl                -text
# CSV was missing here, so the v2.0.2 CSV payloads were checked out with their
# line endings rewritten and stopped matching the SHA-256 their manifest sealed.
data/generated/**/*.csv                  -text

# 해시 봉인 ML 아티팩트. MODEL_CARD/FINAL_VERIFICATION이 SHA-256을 기록하므로
# 줄바꿈 정규화가 개입하면 재검증이 깨진다.
*.parquet binary
*.joblib binary
*.docx binary

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.xlsx binary
