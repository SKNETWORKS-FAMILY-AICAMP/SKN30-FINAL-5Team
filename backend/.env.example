# Application
APP_ENV=local
APP_NAME=exercise-wellness-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
# Use localhost when the API runs on the host. A Docker profile may override
# the hostname with the Compose service name when it is introduced.
DATABASE_URL=postgresql+psycopg://exercise_app:local_dev_only@localhost:5432/exercise_app

# Firebase Admin
# GOOGLE_APPLICATION_CREDENTIALS must point to a credential file outside this repository.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Kakao OAuth
KAKAO_AUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Naver OAuth
NAVER_AUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
