# Application
APP_ENV=local
APP_NAME=exercise-wellness-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
# Use localhost when the API runs on the host. A Docker profile may override
# the hostname with the Compose service name when it is introduced.
DATABASE_URL=postgresql+psycopg://exercise_app:local_dev_only@localhost:5432/exercise_app

# JSON array of repository-relative or absolute manifest paths. Production
# refuses to start when this is empty or a manifest is not production eligible.
CATALOG_MANIFEST_PATHS=[]

# Firebase Admin
# GOOGLE_APPLICATION_CREDENTIALS must point to a credential file outside this repository.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Wave 3 onboarding/consent
# Local/test only: base64-encoded 32-byte AES key. AWS staging/production must
# provide the separately reviewed KMS-backed BirthdateCipher adapter.
BIRTHDATE_ENCRYPTION_KEY_BASE64=
BIRTHDATE_ENCRYPTION_KEY_ID=local-v1
# Deployment-approved values. Empty values make onboarding fail closed.
CONSENT_POLICY_VERSION=
ONBOARDING_PRIMARY_GOAL_CODES=[]
ONBOARDING_EXPERIENCE_LEVEL_CODES=[]

# Kakao OAuth
KAKAO_AUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Naver OAuth
NAVER_AUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
