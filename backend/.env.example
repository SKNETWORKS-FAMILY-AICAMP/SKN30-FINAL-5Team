# Application
APP_ENV=local
APP_NAME=exercise-wellness-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
# Use localhost when the API runs on the host. A Docker profile may override
# the hostname with the Compose service name when it is introduced.
DATABASE_URL=postgresql+psycopg://exercise_app:local_dev_only@localhost:5432/exercise_app

# JSON array of repository-relative or absolute manifest paths. Production
# refuses to start when this is empty or a manifest is not production eligible.
CATALOG_MANIFEST_PATHS=[]

# Firebase Admin
# GOOGLE_APPLICATION_CREDENTIALS must point to a credential file outside this repository.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Wave 3 onboarding/consent
# Local/test only: base64-encoded 32-byte AES key. AWS staging/production must
# provide the separately reviewed KMS-backed BirthdateCipher adapter.
BIRTHDATE_ENCRYPTION_KEY_BASE64=
BIRTHDATE_ENCRYPTION_KEY_ID=local-v1
# Deployment-approved values. Empty values make onboarding fail closed.
# List values accept either a comma-separated list or a JSON array.
CONSENT_POLICY_VERSION=
ONBOARDING_PRIMARY_GOAL_CODES=[]
ONBOARDING_EXPERIENCE_LEVEL_CODES=[]

# Exact browser origins allowed to call the API, comma-separated. Empty
# disables CORS, which is correct for native mobile builds: they send no Origin
# header. Set this only for the browser demo (expo start --web). A wildcard '*'
# is rejected, because it would let any site call the API with a user's token.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=

# Wave 4 optional LLM narration (ADR-0011)
# Disabled by default. When disabled the service uses reviewed template sentences
# and makes no external call. Narration never changes a decision, a safety status
# or a veto. Enabling OPENAI requires OPENAI_API_KEY or the app refuses to start.
# Confirm LLM_MODEL_CODE against the provider's current model list before enabling.
LLM_ENABLED=false
LLM_PROVIDER_CODE=NONE
LLM_MODEL_CODE=gpt-5.1-mini
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=3.0
LLM_MAX_OUTPUT_TOKENS=400
# Never commit a real key. Provide it through the deployment secret store.
OPENAI_API_KEY=

# Kakao OAuth
KAKAO_AUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Naver OAuth
NAVER_AUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
