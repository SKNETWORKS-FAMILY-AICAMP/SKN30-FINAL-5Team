# Application
APP_ENV=local
APP_NAME=exercise-wellness-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL
# Use localhost when the API runs on the host. A Docker profile may override
# the hostname with the Compose service name when it is introduced.
DATABASE_URL=postgresql+psycopg://exercise_app:local_dev_only@localhost:5432/exercise_app

# JSON array of repository-relative or absolute manifest paths. Production
# refuses to start when this is empty or a manifest is not production eligible.
CATALOG_MANIFEST_PATHS=[]

# Firebase Admin
# GOOGLE_APPLICATION_CREDENTIALS must point to a credential file outside this repository.
FIREBASE_PROJECT_ID=
# Absolute path to the Firebase service account key, kept outside the repo.
# Read by the app itself, so it does not need to be exported by the shell.
# Windows: use forward slashes. A backslash here is read as an escape sequence,
# so C:irebase\key.json silently becomes an invalid path.
# Leave empty to use Application Default Credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=
# Tolerance for a server clock that trails Google's when validating a token's
# `iat`. 0 (the SDK default) rejects fresh tokens as "used too early".
FIREBASE_CLOCK_SKEW_SECONDS=60

# Wave 3 onboarding/consent
# Local/test only: base64-encoded 32-byte AES key. AWS staging/production must
# provide the separately reviewed KMS-backed BirthdateCipher adapter.
BIRTHDATE_ENCRYPTION_KEY_BASE64=
BIRTHDATE_ENCRYPTION_KEY_ID=local-v1
# Deployment-approved values. Empty values make onboarding fail closed.
# List values accept either a comma-separated list or a JSON array.
CONSENT_POLICY_VERSION=
ONBOARDING_PRIMARY_GOAL_CODES=[]
ONBOARDING_EXPERIENCE_LEVEL_CODES=[]

# Exact browser origins allowed to call the API, comma-separated. Empty
# disables CORS, which is correct for native mobile builds: they send no Origin
# header. Set this only for the browser demo (expo start --web). A wildcard '*'
# is rejected, because it would let any site call the API with a user's token.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=

# Wave 4 optional LLM narration (ADR-0011)
# Disabled by default. When disabled the service uses reviewed template sentences
# and makes no external call. Narration never changes a decision, a safety status
# or a veto. Enabling OPENAI requires OPENAI_API_KEY or the app refuses to start.
# Confirm LLM_MODEL_CODE against the provider's current model list before enabling.
LLM_ENABLED=false
LLM_PROVIDER_CODE=NONE
LLM_MODEL_CODE=gpt-5.1-mini
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=3.0
LLM_MAX_OUTPUT_TOKENS=400
# Never commit a real key. Provide it through the deployment secret store.
OPENAI_API_KEY=

# V3 provider-neutral structured Agent/Coordinator adapters (ADR-0013)
# Disabled by default. Enabling without an approved, injected BaseChatModel remains
# fail-closed and does not prevent application startup. No provider key or endpoint is
# defined here because the production provider/model has not been selected.
LLM_AGENTS_ENABLED=false
LLM_AGENTS_PROVIDER_CODE=UNCONFIGURED
LLM_AGENTS_MODEL_CODE=unconfigured
LLM_AGENTS_TIMEOUT_SECONDS=5.0
# Total attempts, including the first call. Only one retry is permitted.
LLM_AGENTS_MAX_ATTEMPTS=2
LLM_AGENTS_MAX_OUTPUT_TOKENS=1200
# Canonically sorted, deployment-approved exact model codes. Empty is fail-closed.
LLM_AGENTS_APPROVED_MODEL_CODES=[]
# Builds the V3 graph runtime only when explicitly enabled. It remains disconnected
# from the production decision service until a separate production-switch approval.
V3_LANGGRAPH_ENABLED=false
# Enables only synthetic/offline shadow composition. The CLI must additionally
# receive --allow-provider-calls before an OpenAI model can be constructed.
V3_SHADOW_EVALUATION_ENABLED=false
# Server-owned gate for the V3 regeneration application use case. Keep false
# until V3 persistence round-trip and shadow evaluation gates are approved.
V3_REGENERATION_ENABLED=false
# Application composition profile. LEGACY is the compatibility-preserving default.
# DEMO is accepted only with APP_ENV=staging. SHADOW never changes the public response.
V3_EXECUTION_PROFILE=LEGACY
# Fail-closed production composition input backed by a separately reviewed approval
# record. READY_FOR_HUMAN_APPROVAL/READY_FOR_DEMO evidence alone is not approval.
V3_PRODUCTION_PROMOTION_APPROVED=false

# Qdrant derived exercise index (ADR-0014)
# Disabled by default. Qdrant is never the canonical exercise source.
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=2.0
QDRANT_COLLECTION_PREFIX=exercise_catalog
QDRANT_COLLECTION_ALIAS=exercise_catalog_active
QDRANT_TLS_ENABLED=false
QDRANT_BATCH_SIZE=64
# Deployment owners must approve and provide the concrete embedding contract.
EMBEDDING_PROVIDER_CODE=UNCONFIGURED
EMBEDDING_MODEL_VERSION=unconfigured
EMBEDDING_INPUT_SCHEMA_VERSION=exercise-embedding-input-v2
EMBEDDING_VECTOR_DIMENSION=0
EMBEDDING_DISTANCE_METRIC_CODE=COSINE
EMBEDDING_TIMEOUT_SECONDS=30.0

# Kakao OAuth
KAKAO_AUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Naver OAuth
NAVER_AUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
